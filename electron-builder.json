{
  "appId": "com.sifer360.licoreria",
  "productName": "SIFER 360 Licorería",
  "directories": {
    "output": "dist-exe"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "portable": {
    "artifactName": "SIFER360-1.0.8-Portable.exe"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SIFER360 Licorería",
    "installerIcon": "public/favicon.ico",
    "uninstallerIcon": "public/favicon.ico",
    "installerHeaderIcon": "public/favicon.ico",
    "artifactName": "SIFER360-1.0.8-Instalador.exe"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "fenixlife1978",
      "repo": "Sifer360-licoreria",
      "releaseType": "release"
    }
  ]
}
